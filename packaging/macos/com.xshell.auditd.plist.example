<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xshell.auditd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/xshell-auditd</string>
        <string>--directory</string>
        <string>/var/db/xshell-audit</string>
        <string>--socket</string>
        <string>/var/run/xshell-audit/audit.sock</string>
    </array>
    <key>UserName</key>
    <string>_xshellaudit</string>
    <key>GroupName</key>
    <string>_xshellaudit</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
